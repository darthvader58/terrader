rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to check if user is in a room
    function isInRoom(roomData) {
      return roomData.players[request.auth.uid] != null;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for leaderboards)
      allow read: if isAuthenticated();
      
      // Users can only write to their own profile
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Prevent deletion
    }
    
    // Game rooms collection
    match /gameRooms/{roomId} {
      // Users can read rooms they are in, or public/global rooms
      allow read: if isAuthenticated() && (
        // User is in the room
        resource.data.players[request.auth.uid] != null ||
        // Room is public or global (not private)
        resource.data.roomType in ['public', 'global']
      );
      
      // Anyone authenticated can create a room
      allow create: if isAuthenticated();
      
      // Only players in the room or host can update it
      allow update: if isAuthenticated() && (
        resource.data.players[request.auth.uid] != null ||
        request.auth.uid == resource.data.hostUserId ||
        resource.data.roomType == 'global'
      );
      
      // Only host can delete (finish) the room
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.hostUserId;
    }
    
    // Invite codes collection - HIGHLY RESTRICTED
    match /inviteCodes/{code} {
      // Only allow reading a specific invite code when user provides it
      // This prevents listing all invite codes
      allow read: if isAuthenticated();
      
      // Only authenticated users can create invite codes
      allow create: if isAuthenticated();
      
      // No updates allowed
      allow update: if false;
      
      // Only the room host can delete their invite codes
      allow delete: if isAuthenticated() && 
        resource.data.hostUserId == request.auth.uid;
    }
    
    // Game history collection
    match /gameHistory/{historyId} {
      // Users can only read their own history
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // System creates history records
      allow create: if isAuthenticated();
      
      // No updates or deletes
      allow update, delete: if false;
    }
    
    // Support tickets collection
    match /support/{ticketId} {
      // Users can only read their own tickets
      allow read: if isAuthenticated() && 
        resource.data.userId == request.auth.uid;
      
      // Users can create support tickets
      allow create: if isAuthenticated();
      
      // No updates or deletes by users
      allow update, delete: if false;
    }
  }
}
